__pycache__/
*.pyc
*.pyo
.env
*.egg-info/
dist/
build/
# archive/legacy-v5/build/ holds checked-in build sources from the v5
# snapshot (PyInstaller spec, Inno Setup scripts, helper scripts).
# Don't ignore it.
!archive/legacy-v5/build/
!archive/legacy-v5/build/**

# ── Electron + Vite scaffold ─────────────────────────────────────────────────
node_modules/
out/
.DS_Store
*.tsbuildinfo

# ── Python sidecar build artifacts ───────────────────────────────────────────
backend/.venv/
backend/build/
backend/dist/
backend/*.spec.bak

# Per-user runtime settings written by the sidecar in dev mode. The real
# settings file lives under platformdirs.user_data_dir() in production;
# the in-tree path was a dev-only side effect that briefly leaked into
# git. Tracked-blank file removed in the same commit that adds this rule.
backend/settings.json

# Bundled sidecar copy generated by 3-build-installer.bat right before electron-builder runs.
branding/sidecar-bundle/

# Local logs
*.log

